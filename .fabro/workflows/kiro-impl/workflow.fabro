digraph KiroImpl {
    graph [
        goal="Implement every task of Kiro spec {{ inputs.spec }} in series: dispatch the kiro-task workflow once per task through the Fabro API bridge, integrate each result, and publish a GitHub-native PR stack with one single-commit pull request per task.",
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    prepare [
        label="Prepare and resume",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        goal_gate=true,
        script="import json, os, re, subprocess, sys\n\ndef run(cmd, check=True):\n    r = subprocess.run(cmd, capture_output=True, text=True)\n    if check and r.returncode != 0:\n        sys.exit(\"command failed: %s\\n%s\" % (\" \".join(cmd), r.stderr.strip()))\n    return r.stdout.strip()\n\nSPEC = {{ inputs.spec }}\nBASE = {{ inputs.base }}\nTRUNK_IN = {{ inputs.trunk }}\n\nif not SPEC:\n    sys.exit(\"input 'spec' is empty; pass -I spec=<kiro spec name>\")\n\nstate_path = \".git/kiro-impl-state.json\"\nstate = None\nif os.path.exists(state_path):\n    try:\n        state = json.load(open(state_path))\n    except ValueError:\n        state = None\n\nrun([\"git\", \"fetch\", \"--prune\", \"--quiet\", \"origin\"])\n\ndef detect_trunk():\n    head = run([\"git\", \"symbolic-ref\", \"-q\", \"--short\", \"refs/remotes/origin/HEAD\"], check=False)\n    if head.startswith(\"origin/\"):\n        return head.split(\"/\", 1)[1]\n    out = run([\"git\", \"remote\", \"show\", \"origin\"], check=False)\n    m = re.search(r\"HEAD branch:\\s*(\\S+)\", out)\n    return m.group(1) if m else \"main\"\n\nif state is None:\n    trunk = TRUNK_IN or detect_trunk()\n    state = {\"spec\": SPEC, \"trunk\": trunk, \"layers\": [], \"pending\": [], \"current\": None}\n\n    remote_layers = run([\"git\", \"ls-remote\", \"--heads\", \"origin\", \"refs/heads/stack/%s/*\" % SPEC], check=False)\n    for line in remote_layers.splitlines():\n        parts = line.split(\"\\t\", 1)\n        if len(parts) != 2:\n            continue\n        sha, ref = parts\n        m = re.match(r\"refs/heads/stack/%s/(\\d+)-(.+)$\" % re.escape(SPEC), ref)\n        if not m:\n            continue\n        state[\"layers\"].append({\n            \"layer\": int(m.group(1)),\n            \"task\": m.group(2),\n            \"branch\": ref[len(\"refs/heads/\"):],\n            \"sha\": sha,\n        })\n    state[\"layers\"].sort(key=lambda l: l[\"layer\"])\n\n    resume_ref = BASE or (state[\"layers\"][-1][\"branch\"] if state[\"layers\"] else \"\")\n    if resume_ref:\n        run([\"git\", \"fetch\", \"--quiet\", \"origin\", \"refs/heads/%s\" % resume_ref])\n        run([\"git\", \"merge\", \"--no-edit\", \"FETCH_HEAD\"])\n\nspec_dir = \".kiro/specs/%s\" % SPEC\ntasks_path = os.path.join(spec_dir, \"tasks.md\")\nif not os.path.isfile(tasks_path):\n    sys.exit(\"missing %s; is the spec name correct and committed on this branch?\" % tasks_path)\n\nlines = open(tasks_path).read().splitlines()\ntask_re = re.compile(r\"^- \\[([ x])\\]\\*? (\\d+(?:\\.\\d+)?)\\.? (.*)$\")\n\nentries = []\ni = 0\nwhile i < len(lines):\n    m = task_re.match(lines[i])\n    if not m:\n        i += 1\n        continue\n    block = []\n    j = i + 1\n    while j < len(lines) and not task_re.match(lines[j]):\n        block.append(lines[j])\n        j += 1\n    entries.append({\n        \"checked\": m.group(1) == \"x\",\n        \"id\": m.group(2),\n        \"text\": m.group(3).strip(),\n        \"blocked\": any(\"_Blocked:\" in b for b in block),\n    })\n    i = j\n\nmajor_ids_with_subs = {e[\"id\"].split(\".\")[0] for e in entries if \".\" in e[\"id\"]}\n\npending = []\nblocked_open = []\nfor e in entries:\n    if e[\"checked\"]:\n        continue\n    if \".\" not in e[\"id\"] and e[\"id\"] in major_ids_with_subs:\n        continue\n    if e[\"blocked\"]:\n        blocked_open.append(e[\"id\"])\n        continue\n    pending.append(e[\"id\"])\n\nif blocked_open:\n    sys.exit(\"task(s) %s are marked _Blocked:_ in %s; clear the annotation or check the task before running\" % (\", \".join(blocked_open), tasks_path))\n\nstate[\"pending\"] = pending\nstate[\"tasks_total\"] = len([e for e in entries if \".\" in e[\"id\"] or e[\"id\"] not in major_ids_with_subs])\njson.dump(state, open(state_path, \"w\"), indent=1, sort_keys=True)\n\nprint(\"kiro-impl prepare: spec=%s trunk=%s layers=%d pending=%d\" % (SPEC, state[\"trunk\"], len(state[\"layers\"]), len(pending)), file=sys.stderr)\nprint(json.dumps({\"context_updates\": {\n    \"has_pending\": \"true\" if pending else \"false\",\n    \"pending_count\": str(len(pending)),\n    \"resume_layers\": str(len(state[\"layers\"])),\n}}))"
    ]

    pick [
        label="Pick next task",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        goal_gate=true,
        max_visits=200,
        script="import json, os, re, sys\n\nstate_path = \".git/kiro-impl-state.json\"\nif not os.path.exists(state_path):\n    sys.exit(\"state file %s is missing; prepare must run first\" % state_path)\n\nstate = json.load(open(state_path))\n\nif state.get(\"current\"):\n    sys.exit(\"a dispatch is already recorded in 'current' (task %s); integrate it or clear it before picking a new task\" % state[\"current\"].get(\"task\"))\n\npending = state.get(\"pending\") or []\nif not pending:\n    json.dump(state, open(state_path, \"w\"), indent=1, sort_keys=True)\n    print(json.dumps({\"context_updates\": {\"has_pending\": \"false\"}}))\n    sys.exit(0)\n\nspec = state[\"spec\"]\ntask = pending[0]\n\ntext = \"\"\ntasks_path = \".kiro/specs/%s/tasks.md\" % spec\ntask_re = re.compile(r\"^- \\[([ x])\\]\\*? (\\d+(?:\\.\\d+)?)\\.? (.*)$\")\nfor line in open(tasks_path).read().splitlines():\n    m = task_re.match(line)\n    if m and m.group(2) == task:\n        text = m.group(3).strip()\n        break\n\nlayer = len(state.get(\"layers\") or []) + 1\nbranch = \"stack/%s/%d-%s\" % (spec, layer, task)\n\nstate[\"current\"] = {\"task\": task, \"text\": text, \"layer\": layer, \"branch\": branch}\njson.dump(state, open(state_path, \"w\"), indent=1, sort_keys=True)\n\nprint(\"kiro-impl pick: task=%s layer=%d branch=%s\" % (task, layer, branch), file=sys.stderr)\nprint(json.dumps({\"context_updates\": {\n    \"has_pending\": \"true\",\n    \"next_task\": task,\n    \"next_layer\": str(layer),\n    \"next_layer_branch\": branch,\n}}))"
    ]

    dispatch [
        label="Dispatch task run",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        max_visits=200,
        script="import json, os, re, subprocess, sys, urllib.error, urllib.request\n\nSTATE_PATH = \".git/kiro-impl-state.json\"\nAPI_BASE = os.environ.get(\"KIRO_IMPL_API_BASE\", \"http://host.docker.internal:32276/api/v1\").rstrip(\"/\")\nWORKFLOW_VERSION = {{ vars.kiro_task_workflow_version }}\n\n\ndef run(cmd, check=True):\n    r = subprocess.run(cmd, capture_output=True, text=True)\n    if check and r.returncode != 0:\n        sys.exit(\"command failed: %s\\n%s\" % (\" \".join(cmd), r.stderr.strip()))\n    return r.stdout.strip()\n\n\ndef api(method, path, body=None):\n    data = json.dumps(body).encode() if body is not None else None\n    req = urllib.request.Request(API_BASE + path, method=method, data=data, headers={\n        \"Accept\": \"application/json\",\n        \"Content-Type\": \"application/json\",\n        \"User-Agent\": \"fabro-kiro-impl-workflow\",\n    })\n    try:\n        with urllib.request.urlopen(req, timeout=120) as r:\n            raw = r.read()\n            return r.status, (json.loads(raw) if raw else None)\n    except urllib.error.HTTPError as e:\n        return e.code, e.read().decode(\"utf-8\", \"replace\")[:500]\n    except urllib.error.URLError as e:\n        sys.exit(\"Fabro API bridge at %s is unreachable: %s (is fabro-api-bridge deployed and is this workflow allowed to dispatch?)\" % (API_BASE, e.reason))\n\n\ndef origin_repo():\n    url = run([\"git\", \"config\", \"--get\", \"remote.origin.url\"])\n    m = re.match(r\"(?:https://github\\.com/|git@github\\.com:)([^/]+)/([^/]+?)(?:\\.git)?/?$\", url)\n    if not m:\n        sys.exit(\"cannot derive owner/repo from origin url %r\" % url)\n    return \"%s/%s\" % (m.group(1), m.group(2))\n\n\nif not WORKFLOW_VERSION.strip():\n    sys.exit(\"kiro_task_workflow_version is not pinned; run scripts/pin-workflow-versions.sh on the Fabro server host\")\n\nstate = json.load(open(STATE_PATH))\ncur = state.get(\"current\")\nif not cur or not cur.get(\"task\"):\n    sys.exit(\"no current task in %s; pick must run first\" % STATE_PATH)\n\nspec = state[\"spec\"]\ntask = cur[\"task\"]\nbranch = run([\"git\", \"rev-parse\", \"--abbrev-ref\", \"HEAD\"])\nif not branch or branch == \"HEAD\":\n    sys.exit(\"workspace is not on a branch; cannot derive the dispatch target\")\n\nchild = cur.get(\"child_run_id\")\nif not child:\n    status, created = api(\"POST\", \"/runs\", {\n        \"workflow_version_id\": WORKFLOW_VERSION,\n        \"title\": \"%s task %s\" % (spec, task),\n        \"target\": {\"kind\": \"git\", \"repo\": origin_repo(), \"branch\": branch},\n        \"args\": {\n            \"inputs\": {\"spec\": spec, \"task\": task},\n            \"auto_approve\": True,\n            \"labels\": {\"kiro-spec\": spec, \"kiro-task\": task},\n        },\n    })\n    if not isinstance(status, int) or not (200 <= status < 300):\n        sys.exit(\"run create failed: HTTP %s: %s\" % (status, created))\n    child = (created or {}).get(\"id\") or (created or {}).get(\"run_id\")\n    if not child:\n        sys.exit(\"run create returned no run id: %r\" % created)\n    cur[\"child_run_id\"] = child\n    cur[\"child_workflow_version_id\"] = WORKFLOW_VERSION\n    json.dump(state, open(STATE_PATH, \"w\"), indent=1, sort_keys=True)\n    print(\"kiro-impl dispatch: created child run %s for task %s\" % (child, task), file=sys.stderr)\nelse:\n    print(\"kiro-impl dispatch: reusing recorded child run %s for task %s\" % (child, task), file=sys.stderr)\n\nstatus, started = api(\"POST\", \"/runs/%s/start\" % child, {})\nif status != 409 and not (isinstance(status, int) and 200 <= status < 300):\n    sys.exit(\"start of child run %s failed: HTTP %s: %s\" % (child, status, started))\n\nprint(\"kiro-impl dispatch: task=%s layer=%s child=%s start=HTTP %s\" % (task, cur.get(\"layer\"), child, status), file=sys.stderr)\nprint(json.dumps({\"context_updates\": {\n    \"dispatch_result\": \"success\",\n    \"dispatch_task\": task,\n    \"dispatch_child_run_id\": child,\n}}))"
    ]

    await [
        label="Await task run",
        prompt="@prompts/await.md",
        output_schema="routing",
        max_visits=200
    ]

    integrate [
        label="Integrate task branch",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        max_visits=200,
        script="import json, os, re, subprocess, sys\n\ndef run(cmd, check=True):\n    r = subprocess.run(cmd, capture_output=True, text=True)\n    if check and r.returncode != 0:\n        sys.exit(\"command failed: %s\\n%s\" % (\" \".join(cmd), r.stderr.strip()))\n    return r.stdout.strip()\n\nstate_path = \".git/kiro-impl-state.json\"\nstate = json.load(open(state_path))\ncur = state.get(\"current\")\nif not cur:\n    sys.exit(\"no current dispatch to integrate\")\nchild = cur.get(\"child_run_id\")\nif not child:\n    sys.exit(\"current dispatch for task %s has no child_run_id; the dispatch stage did not record a run\" % cur.get(\"task\"))\n\nspec = state[\"spec\"]\ntask = cur[\"task\"]\nlayer_branch = cur[\"branch\"]\nchild_branch = \"fabro/run/%s\" % child\n\nlayers = state.get(\"layers\") or []\nprev = sorted([l for l in layers if l.get(\"layer\") != cur[\"layer\"]], key=lambda l: l[\"layer\"])\nbase_name = prev[-1][\"branch\"] if prev else state[\"trunk\"]\nrun([\"git\", \"fetch\", \"--quiet\", \"origin\", \"refs/heads/%s\" % base_name])\nbase = run([\"git\", \"rev-parse\", \"FETCH_HEAD\"])\n\nrun([\"git\", \"fetch\", \"--quiet\", \"origin\", \"refs/heads/%s\" % child_branch])\ntip = run([\"git\", \"rev-parse\", \"FETCH_HEAD\"])\n\ntasks_path = \".kiro/specs/%s/tasks.md\" % spec\nmarked = run([\"git\", \"show\", \"%s:%s\" % (tip, tasks_path)], check=False)\npat = re.compile(r\"^- \\[x\\]\\*? %s\\.?(\\s|$)\" % re.escape(task))\nif not any(pat.match(l) for l in marked.splitlines()):\n    sys.exit(\"child branch %s does not mark task %s complete in %s; refusing to integrate\" % (child_branch, task, tasks_path))\n\ntree = run([\"git\", \"rev-parse\", \"%s^{tree}\" % tip])\nident = []\nif not run([\"git\", \"config\", \"user.email\"], check=False):\n    ident = [\"-c\", \"user.name=Fabro\", \"-c\", \"user.email=noreply@fabro.sh\"]\nmessage = \"feat(%s): %s\\n\\nKiro task %s (stack layer %d), child run %s.\" % (spec, cur.get(\"text\") or task, task, cur[\"layer\"], child)\nsquashed = run([\"git\"] + ident + [\"commit-tree\", tree, \"-p\", base, \"-m\", message])\n\nrun([\"git\", \"push\", \"--quiet\", \"--force-with-lease\", \"origin\", \"%s:refs/heads/%s\" % (squashed, layer_branch)])\nrun([\"git\", \"merge\", \"--no-edit\", tip])\n\nexisting = [l for l in layers if l.get(\"layer\") == cur[\"layer\"]]\nif existing:\n    existing[0].update({\"task\": task, \"branch\": layer_branch, \"sha\": squashed, \"child_run_id\": child})\nelse:\n    layers.append({\n        \"layer\": cur[\"layer\"],\n        \"task\": task,\n        \"text\": cur.get(\"text\", \"\"),\n        \"branch\": layer_branch,\n        \"sha\": squashed,\n        \"child_run_id\": child,\n    })\nlayers.sort(key=lambda l: l[\"layer\"])\npending = [t for t in (state.get(\"pending\") or []) if t != task]\n\nstate[\"layers\"] = layers\nstate[\"pending\"] = pending\nstate[\"current\"] = None\njson.dump(state, open(state_path, \"w\"), indent=1, sort_keys=True)\n\nprint(\"kiro-impl integrate: task=%s layer=%d branch=%s sha=%s\" % (task, cur[\"layer\"], layer_branch, squashed[:12]), file=sys.stderr)\nprint(json.dumps({\"context_updates\": {\"has_pending\": \"true\" if pending else \"false\"}}))"
    ]

    publish [
        label="Publish PR stack",
        shape=parallelogram,
        language="python",
        goal_gate=true,
        script="import json, os, re, subprocess, sys, urllib.error, urllib.parse, urllib.request\n\nAPI = os.environ.get(\"KIRO_IMPL_API_BASE\", \"https://api.github.com\").rstrip(\"/\")\nTOKEN = os.environ.get(\"GITHUB_TOKEN\", \"\")\nif not TOKEN:\n    sys.exit(\"GITHUB_TOKEN is not set; declare [run.integrations.github.permissions] on this workflow\")\n\nstate_path = \".git/kiro-impl-state.json\"\nif not os.path.exists(state_path):\n    sys.exit(\"state file %s is missing; prepare must run first\" % state_path)\nstate = json.load(open(state_path))\nlayers = state.get(\"layers\") or []\nif not layers:\n    print(\"kiro-impl publish: no layers to publish; nothing to do\")\n    sys.exit(0)\n\ndef gh(method, path, body=None, expect=(200, 201, 204)):\n    req = urllib.request.Request(API + path, method=method, headers={\n        \"Authorization\": \"Bearer %s\" % TOKEN,\n        \"Accept\": \"application/vnd.github+json\",\n        \"X-GitHub-Api-Version\": \"2026-03-10\",\n        \"Content-Type\": \"application/json\",\n        \"User-Agent\": \"fabro-kiro-impl-workflow\",\n    })\n    data = json.dumps(body).encode() if body is not None else None\n    try:\n        with urllib.request.urlopen(req, data=data, timeout=60) as r:\n            raw = r.read()\n            return r.status, (json.loads(raw) if raw else None)\n    except urllib.error.HTTPError as e:\n        raw = e.read().decode(\"utf-8\", \"replace\")\n        if e.code in expect:\n            try:\n                return e.code, json.loads(raw)\n            except ValueError:\n                return e.code, raw\n        sys.exit(\"GitHub API %s %s failed: HTTP %s\\n%s\" % (method, path, e.code, raw[:1000]))\n\nurl = subprocess.run([\"git\", \"remote\", \"get-url\", \"origin\"], capture_output=True, text=True).stdout.strip()\nm = re.match(r\"https://github\\.com/([^/]+)/([^/]+?)(?:\\.git)?/?$\", url)\nif not m:\n    sys.exit(\"cannot derive owner/repo from origin url %r\" % url)\nowner, repo = m.group(1), m.group(2)\nslug = \"%s/%s\" % (owner, repo)\nspec = state[\"spec\"]\ntrunk = state[\"trunk\"]\n\ndef find_open_pr(head):\n    q = urllib.parse.urlencode({\"state\": \"open\", \"head\": \"%s:%s\" % (owner, head), \"per_page\": 100})\n    st, prs = gh(\"GET\", \"/repos/%s/pulls?%s\" % (slug, q))\n    prs = prs or []\n    if len(prs) > 1:\n        sys.exit(\"multiple open pull requests for head %s: %s\" % (head, [p[\"number\"] for p in prs]))\n    return prs[0] if prs else None\n\nbase = trunk\npr_numbers = []\nfor layer in layers:\n    head = layer[\"branch\"]\n    pr = find_open_pr(head)\n    if pr is None:\n        body = \"Kiro task `%s` of spec `%s`%s.\\n\\nLayer %d of the spec stack. Generated by the kiro-impl workflow.\" % (\n            layer[\"task\"], spec,\n            (\", child run `%s`\" % layer[\"child_run_id\"]) if layer.get(\"child_run_id\") else \"\",\n            layer[\"layer\"])\n        st, created = gh(\"POST\", \"/repos/%s/pulls\" % slug, {\n            \"title\": \"feat(%s): %s\" % (spec, layer.get(\"text\") or layer[\"task\"]),\n            \"head\": head,\n            \"base\": base,\n            \"draft\": True,\n            \"body\": body,\n        }, expect=(201, 422))\n        if st == 422:\n            pr = find_open_pr(head)\n            if pr is None:\n                sys.exit(\"pull request create for head %s returned 422 and no open PR exists\" % head)\n        else:\n            pr = created\n        print(\"kiro-impl publish: created PR #%s %s -> %s\" % (pr.get(\"number\"), head, base))\n    else:\n        print(\"kiro-impl publish: reusing PR #%s for %s\" % (pr.get(\"number\"), head))\n    pr_base = (pr.get(\"base\") or {}).get(\"ref\")\n    if pr_base != base:\n        sys.exit(\"PR #%s base is %r but expected %r; refusing to continue\" % (pr.get(\"number\"), pr_base, base))\n    pr_numbers.append(pr[\"number\"])\n    base = head\n\nstack_number = None\nstack_members = []\nst, stacks = gh(\"GET\", \"/repos/%s/stacks?per_page=100\" % slug)\nfor s in stacks or []:\n    if any(p.get(\"number\") in pr_numbers for p in s.get(\"pull_requests\", [])):\n        stack_number = s.get(\"number\")\n        stack_members = [p.get(\"number\") for p in s.get(\"pull_requests\", [])]\n        break\n\nif len(pr_numbers) < 2:\n    print(\"kiro-impl publish: single PR #%s; GitHub native stacks require at least two PRs, skipping stack creation\" % pr_numbers[0])\n    sys.exit(0)\n\nif stack_number is None:\n    st, created = gh(\"POST\", \"/repos/%s/stacks\" % slug, {\"pull_requests\": pr_numbers})\n    stack_number = created.get(\"number\")\n    stack_members = [p.get(\"number\") for p in created.get(\"pull_requests\", [])]\n    print(\"kiro-impl publish: created stack #%s %s\" % (stack_number, pr_numbers))\nelse:\n    missing = [n for n in pr_numbers if n not in stack_members]\n    if missing:\n        if stack_members:\n            st, top_pr = gh(\"GET\", \"/repos/%s/pulls/%s\" % (slug, stack_members[-1]))\n            st, first_new = gh(\"GET\", \"/repos/%s/pulls/%s\" % (slug, missing[0]))\n            if (first_new.get(\"base\") or {}).get(\"ref\") != (top_pr.get(\"head\") or {}).get(\"ref\"):\n                sys.exit(\"stack #%s append precondition failed: PR #%s base %r != current top PR #%s head %r\" % (\n                    stack_number, missing[0], (first_new.get(\"base\") or {}).get(\"ref\"),\n                    stack_members[-1], (top_pr.get(\"head\") or {}).get(\"ref\")))\n        st, updated = gh(\"POST\", \"/repos/%s/stacks/%s/add\" % (slug, stack_number), {\"pull_requests\": missing})\n        stack_members = [p.get(\"number\") for p in updated.get(\"pull_requests\", [])]\n        print(\"kiro-impl publish: appended %s to stack #%s\" % (missing, stack_number))\n    else:\n        print(\"kiro-impl publish: stack #%s already contains all %d PRs\" % (stack_number, len(pr_numbers)))\n\nst, final = gh(\"GET\", \"/repos/%s/stacks/%s\" % (slug, stack_number))\norder = [p.get(\"number\") for p in final.get(\"pull_requests\", [])]\nprint(\"kiro-impl publish: stack #%s bottom-to-top: %s (base %s)\" % (\n    stack_number, order, (final.get(\"base\") or {}).get(\"ref\")))"
    ]

    fail [
        label="Fail run",
        shape=parallelogram,
        stdin_source="dispatch_failure",
        script="set -eu\nMSG=$(cat || true)\nif [ -z \"$MSG\" ]; then\n  MSG=\"a kiro-impl stage failed; inspect the failing stage output in the run events and .git/kiro-impl-state.json\"\nfi\nprintf 'kiro-impl: %s\\n' \"$MSG\" >&2\nexit 1"
    ]

    start -> prepare

    prepare -> pick [condition="outcome=succeeded"]
    prepare -> fail

    pick -> dispatch [condition="outcome=succeeded && context.has_pending=true"]
    pick -> publish [condition="outcome=succeeded && context.has_pending=false"]
    pick -> fail

    dispatch -> await [condition="outcome=succeeded"]
    dispatch -> fail

    await -> integrate [condition="outcome=succeeded && context.dispatch_result=success"]
    await -> fail

    integrate -> pick [condition="outcome=succeeded && context.has_pending=true"]
    integrate -> publish [condition="outcome=succeeded && context.has_pending=false"]
    integrate -> fail

    publish -> exit
    fail -> exit
}
