digraph Dispatch {
    graph [
        goal="Scan {{ inputs.repo }} for open issues labeled {{ inputs.ready_label }}, match each issue's type label against the dispatch rules, and create one child run per matched issue through the Fabro API bridge.",
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    scan [
        label="Scan ready issues",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        goal_gate=true,
        script="import json, os, re, subprocess, sys, urllib.error, urllib.parse, urllib.request\n\nQUEUE_PATH = \".git/dispatch-queue.json\"\n\n\ndef gh(path):\n    token = os.environ.get(\"GITHUB_TOKEN\", \"\")\n    if not token:\n        sys.exit(\"GITHUB_TOKEN is not set; declare [run.integrations.github.permissions] on this workflow\")\n    base = os.environ.get(\"DISPATCH_GITHUB_API_BASE\", \"https://api.github.com\").rstrip(\"/\")\n    req = urllib.request.Request(base + path, method=\"GET\", headers={\n        \"Authorization\": \"Bearer %s\" % token,\n        \"Accept\": \"application/vnd.github+json\",\n        \"X-GitHub-Api-Version\": \"2026-03-10\",\n        \"User-Agent\": \"fabro-dispatch-workflow\",\n    })\n    try:\n        with urllib.request.urlopen(req, timeout=60) as r:\n            return json.loads(r.read() or b\"[]\")\n    except urllib.error.HTTPError as e:\n        sys.exit(\"GitHub API GET %s failed: HTTP %s\\n%s\" % (path, e.code, e.read().decode(\"utf-8\", \"replace\")[:1000]))\n\n\ndef origin_repo():\n    url = subprocess.run([\"git\", \"config\", \"--get\", \"remote.origin.url\"], capture_output=True, text=True).stdout.strip()\n    m = re.match(r\"(?:https://github\\.com/|git@github\\.com:)([^/]+)/([^/]+?)(?:\\.git)?/?$\", url)\n    if not m:\n        sys.exit(\"cannot derive owner/repo from origin url %r; pass -I repo=<owner/name>\" % url)\n    return m.group(1), m.group(2)\n\n\nrepo_in = {{ inputs.repo }}.strip()\nready = {{ inputs.ready_label }}.strip()\n\nif not ready:\n    sys.exit(\"input 'ready_label' is empty; pass the label that marks issues as ready, for example -I ready_label=fabro-ready\")\n\nif repo_in:\n    m = re.match(r\"^([^/\\s]+)/([^/\\s]+?)(?:\\.git)?$\", repo_in)\n    if not m:\n        sys.exit(\"input 'repo' must be owner/name; got %r\" % repo_in)\n    owner, repo = m.group(1), m.group(2)\nelse:\n    owner, repo = origin_repo()\n\nissues = []\npage = 1\nwhile page <= 10:\n    q = urllib.parse.urlencode({\"state\": \"open\", \"labels\": ready, \"per_page\": 100, \"page\": page})\n    batch = gh(\"/repos/%s/%s/issues?%s\" % (owner, repo, q)) or []\n    issues.extend(i for i in batch if not i.get(\"pull_request\"))\n    if len(batch) < 100:\n        break\n    page += 1\n\nissues.sort(key=lambda i: i.get(\"number\", 0))\ndefault_branch = (gh(\"/repos/%s/%s\" % (owner, repo)) or {}).get(\"default_branch\") or \"main\"\nqueue = {\n    \"repo\": \"%s/%s\" % (owner, repo),\n    \"ready_label\": ready,\n    \"default_branch\": default_branch,\n    \"issues\": [\n        {\n            \"number\": i[\"number\"],\n            \"title\": (i.get(\"title\") or \"\").strip(),\n            \"url\": i.get(\"html_url\", \"\"),\n            \"labels\": [l.get(\"name\") for l in (i.get(\"labels\") or []) if l.get(\"name\")],\n        }\n        for i in issues\n    ],\n}\nwith open(QUEUE_PATH, \"w\") as f:\n    json.dump(queue, f, indent=1, sort_keys=True)\n\nprint(\"dispatch scan: repo=%s issues=%d labels=%s\" % (queue[\"repo\"], len(queue[\"issues\"]), ready), file=sys.stderr)\nprint(json.dumps({\"context_updates\": {\n    \"has_issues\": \"true\" if queue[\"issues\"] else \"false\",\n    \"issue_count\": str(len(queue[\"issues\"])),\n}}))"
    ]

    match [
        label="Match dispatch rules",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        script="import json, sys\n\nQUEUE_PATH = \".git/dispatch-queue.json\"\nPLAN_PATH = \".git/dispatch-plan.json\"\n\nRULES = [\n    {\"label\": \"type/kiro-spec\", \"workflow\": \"kiro-spec\", \"workflow_version_id\": {{ vars.kiro_spec_workflow_version }}, \"label_swap\": \"dispatcher\"},\n    {\"label\": \"type/oneshot\", \"workflow\": \"oneshot\", \"workflow_version_id\": {{ vars.oneshot_workflow_version }}, \"label_swap\": \"child\"},\n]\n\nqueue = json.load(open(QUEUE_PATH))\nentries, ambiguous, skipped = [], [], []\nfor issue in queue[\"issues\"]:\n    labels = issue.get(\"labels\") or []\n    matched = [r for r in RULES if r[\"label\"] in labels]\n    if len(matched) == 1:\n        rule = matched[0]\n        entries.append({\n            \"number\": issue[\"number\"],\n            \"title\": issue.get(\"title\", \"\"),\n            \"url\": issue.get(\"url\", \"\"),\n            \"workflow\": rule[\"workflow\"],\n            \"workflow_version_id\": rule[\"workflow_version_id\"],\n            \"label_swap\": rule[\"label_swap\"],\n        })\n    elif len(matched) > 1:\n        ambiguous.append({\"number\": issue[\"number\"], \"labels\": sorted(r[\"label\"] for r in matched)})\n    else:\n        skipped.append({\"number\": issue[\"number\"], \"labels\": sorted(labels)})\n\nplan = {\n    \"repo\": queue[\"repo\"],\n    \"default_branch\": queue[\"default_branch\"],\n    \"entries\": entries,\n    \"ambiguous\": ambiguous,\n    \"skipped\": skipped,\n}\nwith open(PLAN_PATH, \"w\") as f:\n    json.dump(plan, f, indent=1, sort_keys=True)\n\nfor entry in skipped:\n    print(\"dispatch match: skipping %s#%s (labels %s match no rule)\" % (queue[\"repo\"], entry[\"number\"], entry[\"labels\"]), file=sys.stderr)\n\nif ambiguous:\n    details = \", \".join(\"#%s (%s)\" % (a[\"number\"], \"+\".join(a[\"labels\"])) for a in ambiguous)\n    sys.exit(\"dispatch match: ambiguous type labels on %s; refusing to dispatch the batch: %s\" % (queue[\"repo\"], details))\n\nprint(\"dispatch match: repo=%s matched=%d skipped=%d\" % (queue[\"repo\"], len(entries), len(skipped)), file=sys.stderr)\nprint(json.dumps({\"context_updates\": {\n    \"has_plan\": \"true\" if entries else \"false\",\n    \"matched_count\": str(len(entries)),\n    \"skipped_count\": str(len(skipped)),\n}}))"
    ]

    dispatch [
        label="Dispatch child runs",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        script="import json, os, sys, urllib.error, urllib.parse, urllib.request\n\nPLAN_PATH = \".git/dispatch-plan.json\"\nRESULT_PATH = \".git/dispatch-result.json\"\nAPI_BASE = os.environ.get(\"DISPATCH_API_BASE\", \"http://host.docker.internal:32276/api/v1\").rstrip(\"/\")\nREADY = {{ inputs.ready_label }}.strip()\nRUNNING = {{ inputs.running_label }}.strip()\n\n\ndef api(method, path, body=None):\n    data = json.dumps(body).encode() if body is not None else None\n    req = urllib.request.Request(API_BASE + path, method=method, data=data, headers={\n        \"Accept\": \"application/json\",\n        \"Content-Type\": \"application/json\",\n        \"User-Agent\": \"fabro-dispatch-workflow\",\n    })\n    try:\n        with urllib.request.urlopen(req, timeout=120) as r:\n            raw = r.read()\n            return r.status, (json.loads(raw) if raw else None)\n    except urllib.error.HTTPError as e:\n        detail = e.read().decode(\"utf-8\", \"replace\")[:500]\n        raise RuntimeError(\"HTTP %s from %s %s: %s\" % (e.code, method, path, detail))\n\n\ndef gh(method, path, body=None):\n    token = os.environ.get(\"GITHUB_TOKEN\", \"\")\n    if not token:\n        raise RuntimeError(\"GITHUB_TOKEN is not set\")\n    base = os.environ.get(\"DISPATCH_GITHUB_API_BASE\", \"https://api.github.com\").rstrip(\"/\")\n    data = json.dumps(body).encode() if body is not None else None\n    req = urllib.request.Request(base + path, method=method, data=data, headers={\n        \"Authorization\": \"Bearer %s\" % token,\n        \"Accept\": \"application/vnd.github+json\",\n        \"X-GitHub-Api-Version\": \"2026-03-10\",\n        \"Content-Type\": \"application/json\",\n        \"User-Agent\": \"fabro-dispatch-workflow\",\n    })\n    try:\n        with urllib.request.urlopen(req, timeout=60) as r:\n            raw = r.read()\n            return r.status, (json.loads(raw) if raw else None)\n    except urllib.error.HTTPError as e:\n        detail = e.read().decode(\"utf-8\", \"replace\")[:500]\n        raise RuntimeError(\"GitHub API HTTP %s from %s %s: %s\" % (e.code, method, path, detail))\n\n\nplan = json.load(open(PLAN_PATH))\nrepo = plan[\"repo\"]\nbranch = plan[\"default_branch\"]\nresult = {\"repo\": repo, \"dispatched\": [], \"failed\": [], \"skipped\": plan.get(\"skipped\", [])}\n\n\ndef save():\n    with open(RESULT_PATH, \"w\") as f:\n        json.dump(result, f, indent=1, sort_keys=True)\n\n\nsave()\nfor entry in plan[\"entries\"]:\n    number = str(entry[\"number\"])\n    try:\n        status, run = api(\"POST\", \"/runs\", {\n            \"workflow_version_id\": entry[\"workflow_version_id\"],\n            \"title\": \"%s for %s#%s\" % (entry[\"workflow\"], repo, number),\n            \"target\": {\"kind\": \"git\", \"repo\": repo, \"branch\": branch},\n            \"args\": {\n                \"inputs\": {\"issue\": number},\n                \"labels\": {\"source\": \"dispatch\", \"repo\": repo, \"issue\": number},\n                \"auto_approve\": True,\n            },\n        })\n        run_id = (run or {}).get(\"id\") or (run or {}).get(\"run_id\")\n        if not run_id:\n            raise RuntimeError(\"run create returned no run id: %r\" % run)\n        api(\"POST\", \"/runs/%s/start\" % run_id, {})\n        item = {\"issue\": number, \"workflow\": entry[\"workflow\"], \"run_id\": run_id}\n        if entry[\"label_swap\"] == \"dispatcher\":\n            try:\n                gh(\"POST\", \"/repos/%s/issues/%s/labels\" % (repo, number), {\"labels\": [RUNNING]})\n                gh(\"DELETE\", \"/repos/%s/issues/%s/labels/%s\" % (repo, number, urllib.parse.quote(READY, safe=\"\")))\n            except Exception as e:\n                item[\"label_error\"] = str(e)[:500]\n        result[\"dispatched\"].append(item)\n    except Exception as e:\n        result[\"failed\"].append({\"issue\": number, \"error\": str(e)[:500]})\n    save()\n\nprint(\"dispatch: repo=%s dispatched=%d failed=%d skipped=%d\" % (repo, len(result[\"dispatched\"]), len(result[\"failed\"]), len(result[\"skipped\"])), file=sys.stderr)\nfor failure in result[\"failed\"]:\n    print(\"dispatch: failed %s#%s: %s\" % (repo, failure[\"issue\"], failure[\"error\"]), file=sys.stderr)\nif result[\"failed\"]:\n    print(json.dumps({\"context_updates\": {\n        \"dispatch_result\": \"failed\",\n        \"dispatched_count\": str(len(result[\"dispatched\"])),\n        \"failed_count\": str(len(result[\"failed\"])),\n    }}))\n    sys.exit(1)\nprint(json.dumps({\"context_updates\": {\n    \"dispatch_result\": \"success\",\n    \"dispatched_count\": str(len(result[\"dispatched\"])),\n    \"failed_count\": \"0\",\n}}))"
    ]

    fail [
        label="Fail run",
        shape=parallelogram,
        stdin_source="stage_failure",
        script="set -eu\nMSG=$(cat || true)\nif [ -z \"$MSG\" ]; then\n  MSG=\"a dispatch stage failed; inspect the failing stage output in the run events and .git/dispatch-queue.json, .git/dispatch-plan.json, .git/dispatch-result.json\"\nfi\nprintf 'dispatch: %s\\n' \"$MSG\" >&2\nexit 1"
    ]

    start -> scan

    scan -> match [condition="outcome=succeeded && context.has_issues=true"]
    scan -> exit [condition="outcome=succeeded && context.has_issues=false"]
    scan -> fail

    match -> dispatch [condition="outcome=succeeded && context.has_plan=true"]
    match -> exit [condition="outcome=succeeded && context.has_plan=false"]
    match -> fail

    dispatch -> exit [condition="outcome=succeeded"]
    dispatch -> fail

    fail -> exit
}
